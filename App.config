		<add key="Store_4_DateSentStart" value="" />
		<add key="Store_4_MaxRecords" value="10000" />
		<add key="Store_4_Enabled" value="true" />

		<!-- Store 5 -->
		<add key="Store_5_AccessToken" value="%STORE_5_ACCESS_TOKEN%" />
		<add key="Store_5_Name" value="Taylorsville" />
		<add key="Store_5_DeliveryType" value="manual" />
		<add key="Store_5_Status" value="sent" />
		<add key="Store_5_DateSentStart" value="" />
		<add key="Store_5_MaxRecords" value="10000" />
		<add key="Store_5_Enabled" value="true" />

		<!-- Store 6 -->
		<add key="Store_6_AccessToken" value="%STORE_6_ACCESS_TOKEN%" />
		<add key="Store_6_Name" value="Country Mart KC" />
		<add key="Store_6_DeliveryType" value="manual" />
		<add key="Store_6_Status" value="sent" />
		<add key="Store_6_DateSentStart" value="" />
		<add key="Store_6_MaxRecords" value="10000" />
		<add key="Store_6_Enabled" value="true" />

		<!-- Store 7 -->
		<add key="Store_7_AccessToken" value="%STORE_7_ACCESS_TOKEN%" />
		<add key="Store_7_Name" value="Greer's" />
		<add key="Store_7_DeliveryType" value="manual" />
		<add key="Store_7_Status" value="sent" />
		<add key="Store_7_DateSentStart" value="" />
		<add key="Store_7_MaxRecords" value="10000" />
		<add key="Store_7_Enabled" value="true" />

		<!-- Store 8 -->
		<add key="Store_8_AccessToken" value="%STORE_8_ACCESS_TOKEN%" />
		<add key="Store_8_Name" value="Store 8 Name" />
		<add key="Store_8_DeliveryType" value="manual" />
		<add key="Store_8_Status" value="sent" />
		<add key="Store_8_DateSentStart" value="" />
		<add key="Store_8_MaxRecords" value="10000" />
		<add key="Store_8_Enabled" value="false" />

		<!-- Store 9 -->
		<add key="Store_9_AccessToken" value="%STORE_9_ACCESS_TOKEN%" />
		<add key="Store_9_Name" value="Store 9 Name" />
		<add key="Store_9_DeliveryType" value="manual" />
		<add key="Store_9_Status" value="sent" />
		<add key="Store_9_DateSentStart" value="2025-01-01" />
		<add key="Store_9_MaxRecords" value="10000" />
		<add key="Store_9_Enabled" value="false" />
		
        <!-- Coupon API Configuration -->
        <add key="CouponStartDate" value="2025-09-25" />
        <add key="CouponEndDate" value="2025-09-25" />
        <add key="CouponDaysBack" value="1" />
        <add key="CouponStatuses" value="string" />
        
        <!-- General Configuration -->
        <add key="OutputDirectory" value="output" />
        <add key="JsonFilePath" value="response.json" />
        <add key="MaxRecordsToProcess" value="1000" />
        <add key="UseLocalFile" value="false" />
        
        <!-- GiveX Configuration -->
        <add key="RunGiveXEmail" value="false" />
        <add key="GiveXCertcoNetworkPath" value="\\vm-fileserver\FTP\Certco\GiveX\Coupon_Data\" />
        <add key="GiveXAwgNetworkPath" value="\\vm-fileserver\FTP\AWG\GiveX\Coupon_Data\" />
        <add key="GiveXLocalPath" value="downloads\givex" />
        <add key="GiveXCleanupFiles" value="false" />
        <add key="GiveXCertcoEmailArchivePath" value="\\vm-fileserver\FTP\Certco\GiveX\Email_Data\Archive\" />
        <add key="GiveXAwgEmailArchivePath" value="\\vm-fileserver\FTP\AWG\GiveX\Email_Data\Archive\" />
        <add key="GiveXCertcoLoyaltyArchivePath" value="\\vm-fileserver\FTP\Certco\GiveX\Loyalty_Data\Archive\" />
        <add key="GiveXCertcoCouponArchivePath" value="\\vm-fileserver\FTP\Certco\GiveX\Coupon_Data\Archive\" />
        <!-- Certco FTP Credentials -->
        <add key="GiveXCertcoFtpHost" value="ftp://ftp.ampm1.com" />
        <add key="GiveXCertcoFtpUsername" value="givex_01" />
        <add key="GiveXCertcoFtpPassword" value="GX#718_)" />
        <!-- AWG FTP Credentials -->
        <add key="GiveXAwgFtpHost" value="ftp://ftp.ampm1.com" />
        <add key="GiveXAwgFtpUsername" value="givex_02" />
        <add key="GiveXAwgFtpPassword" value="5MHts7Dj)" />
        
        <!-- AppCard SFTP Configuration -->
        <add key="AppCardSftpHost" value="%APPCARD_SFTP_HOST%" />
        <add key="AppCardSftpPort" value="22" />
        <add key="AppCardSftpUsername" value="awgAppCard" />
        <add key="AppCardSftpPassword" value="%APPCARD_SFTP_PASSWORD%" />
        <add key="AppCardSftpRemotePath" value="awg_appcard/Incoming" />
        <add key="AppCardLocalPath" value="downloads\appcard" />
        <add key="AppCardCleanupFiles" value="false" />
        
        <!-- BrData Configuration -->
        <add key="BrDataSourceNetworkPath" value="\\vm-fileserver\FTP\Certco\BRdata\IncomingPOS\" />
        <add key="BrDataArchivePath" value="\\vm-fileserver\FTP\Certco\BRdata\IncomingPOS\Archive\" />
        <add key="BrDataLocalPath" value="downloads\brdata" />
        <add key="BrDataCleanupFiles" value="false" />
        
        <!-- Brick API Configuration -->
        <add key="BrickBaseUrl" value="https://serve.withbrick.com" />
        <add key="BrickUsername" value="awg" />
        <add key="BrickPassword" value="%BRICK_PASSWORD%" />
        <add key="BrickDefaultCampaignId" value="1" />
        <add key="BrickDailyStatisticsCampaignId" value="2" />
        <add key="BrickDailyStatisticsStartDate" value="2025-09-01" />
        <add key="BrickDailyStatisticsEndDate" value="2025-11-18" />
        <add key="BrickDailyStatisticsEndDateAddDays" value="7" />
        <add key="BrickDefaultDataType" value="JSON" />
        <add key="BrickTimeoutSeconds" value="30" />
        <add key="BrickEnableLogging" value="true" />
        <add key="BrickStartDate" value="2025-09-01" />
        <add key="BrickEndDate" value="2025-11-18" />
        
        <!-- MongoDB Configuration -->
        <add key="MongoDbConnectionString" value="mongodb+srv://%MONGODB_USERNAME%:%MONGODB_PASSWORD%@%MONGODB_HOST%/%MONGODB_DATABASE%?retryWrites=true&amp;w=majority" />
        <add key="MongoDbDatabaseName" value="%MONGODB_DATABASE_NAME%" />
        <add key="MongoDbTestDatabaseName" value="%MONGODB_TEST_DATABASE_NAME%" />
        <add key="MongoDbEmfluenceCollection" value="emfluence_email" />
        <add key="MongoDbAwgGiveXCuratedDatabaseName" value="integration_test" />
        <add key="MongoDbAwgGiveXCuratedCollectionName" value="AWG_giveX_CuratedEmails" />
        <add key="EnableMongoDbStorage" value="true" />
        
        <!-- Logging Configuration -->
        <add key="EnableDetailedLogging" value="true" />
        <add key="LogToFile" value="false" />
        <add key="LogFilePath" value="DataStudioDataMgr.log" />
    </appSettings>
</configuration>

