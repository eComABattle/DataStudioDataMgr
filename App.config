<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <connectionStrings>
        <add name="DefaultConnection" 
             connectionString="Server=(localdb)\mssqllocaldb;Database=DataStudioDataMgr;Trusted_Connection=true;MultipleActiveResultSets=true;" 
             providerName="System.Data.SqlClient" />
		<add name="MongoDbConnectionString" connectionString="mongodb+srv://admin:4ZAqu8qnwTnkFch@cluster0.rkrpr.mongodb.net/?retryWrites=true&amp;w=majority" />
    </connectionStrings>
    
    <appSettings>
        <!-- Service Execution Configuration -->
        <add key="RunEmfluenceApi" value="true" />
        <add key="RunCouponApi" value="false" />
        <add key="RunTestEmailMethod" value="false" />
        
        <!-- Emfluence API Configuration -->
        <add key="EmfluenceAccessToken" value="459F7AAF-77D6-4AAB-8EC4-75D2E926790E" />
        <add key="EmfluenceDeliveryType" value="manual" />
        <add key="EmfluenceStatus" value="sent" />
        <add key="EmfluenceDateSentStart" value="2024-01-01" />
        <add key="EmfluenceMaxRecords" value="10000" />
        <add key="TestStartDate" value="" />

		<!-- Additional Store Configurations -->
		<!-- Store 1 -->
		<add key="Store_1_AccessToken" value="459F7AAF-77D6-4AAB-8EC4-75D2E926790E" />
		<add key="Store_1_Name" value="Store 1 Name" />
		<add key="Store_1_DeliveryType" value="manual" />
		<add key="Store_1_Status" value="sent" />
		<add key="Store_1_DateSentStart" value="2024-01-01" />
		<add key="Store_1_MaxRecords" value="10000" />
		<add key="Store_1_Enabled" value="true" />

		<!-- Store 2 -->
		<add key="Store_2_AccessToken" value="459F7AAF-77D6-4AAB-8EC4-75D2E926790E" />
		<add key="Store_2_Name" value="Store 2 Name" />
		<add key="Store_2_DeliveryType" value="manual" />
		<add key="Store_2_Status" value="sent" />
		<add key="Store_2_DateSentStart" value="2024-01-01" />
		<add key="Store_2_MaxRecords" value="10000" />
		<add key="Store_2_Enabled" value="true" />
        
        <!-- Coupon API Configuration -->
        <add key="CouponStartDate" value="2025-09-25" />
        <add key="CouponEndDate" value="2025-09-25" />
        <add key="CouponDaysBack" value="30" />
        <add key="CouponStatuses" value="string" />
        
        <!-- General Configuration -->
        <add key="OutputDirectory" value="output" />
        <add key="JsonFilePath" value="response.json" />
        <add key="MaxRecordsToProcess" value="1000" />
        <add key="UseLocalFile" value="false" />
        
        <!-- MongoDB Configuration -->
        <add key="MongoDbConnectionString" value="mongodb://localhost:27017" />
        <add key="MongoDbDatabaseName" value="integration_test" />
        <add key="MongoDbEmfluenceCollection" value="emfluence_email" />
        <add key="EnableMongoDbStorage" value="true" />
        
        <!-- Logging Configuration -->
        <add key="EnableDetailedLogging" value="true" />
        <add key="LogToFile" value="false" />
        <add key="LogFilePath" value="DataStudioDataMgr.log" />
    </appSettings>
</configuration>

